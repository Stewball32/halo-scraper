# ─────────────────────────────────────────────
#  halo-scraper configuration
#  Copy this file to halo-scraper.toml and edit it.
#  Place halo-scraper.toml next to the scraper binary (or in the working directory).
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
#  Socket directory — auto-discover xemu instances
#
#  When set, the scraper watches this directory for .sock files.
#  Each socket's filename (minus .sock) becomes the instance name.
#  The watcher polls every socket_poll_ms (default 2000ms).
#
#  When a connectable socket appears, a scraper instance starts.
#  When a socket disappears or goes stale, the instance is stopped.
#
#  Leave empty to use [[hosts]] only (backward compatible).
# ─────────────────────────────────────────────

socket_dir = "./containers/xemu/qmp"
# socket_poll_ms = 2000


[server]
# Address the WebSocket server listens on.
# Overlays and the debug page connect here.
addr = ":9000"

# Maximum rate to send tick messages to WebSocket clients.
# Halo CE ticks at 30Hz — set lower if overlays don't need full fidelity.
# Example: 10 = scoreboard overlay, 30 = smooth position/health tracking.
tick_hz = 30


[pocketbase]
# Set to false to disable all PocketBase writes entirely.
# Useful when you don't need persistent stat storage.
enabled = false

# Base URL of your PocketBase instance.
url = "http://localhost:8090"


[performance]
# How often to poll when not in a game (menu, lobby, postgame).
# Higher = less CPU, slower state detection. 500ms is plenty.
idle_ms = 500

# Spin-wait interval while in game, waiting for the next tick.
# Halo CE runs at 30Hz (~33ms per tick). At 10ms we check ~3x per tick.
# Raise to 16–33ms to cut CPU use, at the cost of slight tick-read latency.
game_ms = 10

# Set to false to skip event detection entirely (kills, deaths, spawns, etc.).
# Note: game_start and game_end still fire regardless of this setting.
# Saves per-tick memory reads. Use when you only need raw player state.
events = true


# ─────────────────────────────────────────────
#  Container management (podman)
#
#  When enabled, the scraper can create/start/stop/remove xemu+browser
#  container pairs via the /api/containers endpoints.
#  Ports are auto-allocated starting at port_base with a stride per instance.
#
#  Per-instance port layout (stride = 10):
#    +0  xemu HTTP      (CUSTOM_PORT)
#    +1  xemu HTTPS     (CUSTOM_HTTPS_PORT)
#    +2  xemu WS        (CUSTOM_WS_PORT)
#    +3  browser web    (WEB_LISTENING_PORT)
#    +4  browser VNC    (VNC_LISTENING_PORT)
# ─────────────────────────────────────────────

[containers]
enabled     = false
shared_dir  = "./containers/xemu/shared"
init_dir    = "./containers/xemu/init"
configs_dir = "./containers/xemu/configs"
browser_dir      = "./containers/browser"
browser_init_dir = "./containers/browser/init"
port_base        = 3100
port_stride = 10
state_file  = "./containers/state.json"

# Selkies streaming defaults (xemu container env vars).
encoder           = "x264enc"
framerate         = 60
crf               = 20
width             = 960
height            = 720
pixelflux_wayland = true
drinode           = "/dev/dri/renderD128"
shm_size          = "1g"
browser_shm_size  = "2gb"


# ─────────────────────────────────────────────
#  Hosts — optional per-host overrides.
#
#  In socket_dir mode, these are matched by name to discovered sockets.
#  A host with an explicit qmp_sock bypasses discovery (always started).
#
#  In legacy mode (socket_dir empty), hosts are the only source of instances.
# ─────────────────────────────────────────────

# [[hosts]]
# name     = "xemu-alpha"
# idle_ms  = 250
# game_ms  = 16
# events   = false

# [[hosts]]
# name     = "xemu-bravo"
# qmp_sock = "/custom/path/to/xemu-bravo.sock"
